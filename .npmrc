engine-strict=true

# On this machine (Windows + the DSH sandbox) pnpm's default isolated node_modules layout does
# not let Node's ESM resolution traverse the directory junctions pnpm creates, and vite fails
# with "Cannot find package 'esbuild'". With the flat layout every package is a real directory,
# so builds are stable. No dependency package changed and the lockfile is unaffected.
node-linker=hoisted
